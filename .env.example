# Cognee LLM (required): see https://docs.cognee.ai
LLM_PROVIDER=openai            # openai | anthropic | gemini | ollama | custom
LLM_MODEL=gpt-4o-mini          # e.g. anthropic: claude-3-5-sonnet-latest
LLM_API_KEY=
# LLM_ENDPOINT=                # only for custom/ollama endpoints

# Embeddings (defaults to the LLM provider; fastembed works locally)
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384

# Optional graph backend: Neo4j instead of the default local graph store
# GRAPH_DATABASE_PROVIDER=neo4j
# GRAPH_DATABASE_URL=bolt://localhost:7687
# GRAPH_DATABASE_USERNAME=neo4j
# GRAPH_DATABASE_PASSWORD=
